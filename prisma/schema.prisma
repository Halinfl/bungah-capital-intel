// Bungah Capital Intel — Capital Graph schema
// PostgreSQL (Neon / Vercel / Docker). Set DATABASE_URL in .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  region      String
  summary     String
  nuanceNote  String?
  visitorsM   Float?
  roomsK      Float?
  occupancy   Float?
  adr         Float?
  midweekOcc  Float?
  weekendOcc  Float?
  sourceLabel String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets    Asset[]
  signals   Signal[]
  findings  Finding[]
  artifacts Artifact[]
}

model Asset {
  id          String   @id @default(cuid())
  marketId    String
  name        String
  assetClass  String
  keys        Int?
  submarket   String?
  notes       String?
  sourceLabel String
  createdAt   DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
}

model Signal {
  id          String   @id @default(cuid())
  marketId    String?
  kind        String
  title       String
  body        String
  magnitude   String?
  asOf        String?
  sourceLabel String
  /// Original article links: [{ url, label, secondary }]. Null = none recorded (e.g. "no public read").
  sourceUrls  Json?
  createdAt   DateTime @default(now())

  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
}

model Radar {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  marketSlug  String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  findings Finding[]
}

model Finding {
  id          String   @id @default(cuid())
  radarId     String
  marketId    String?
  title       String
  summary     String
  severity    String   @default("info")
  sourceLabel String
  createdAt   DateTime @default(now())

  radar  Radar   @relation(fields: [radarId], references: [id], onDelete: Cascade)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
}

model Artifact {
  id          String   @id @default(cuid())
  marketId    String?
  kind        String
  title       String
  markdown    String
  sourceLabel String
  createdAt   DateTime @default(now())

  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
}

/// One conversation = one thread (Chat foundation, 2026-11-14). Rows written before the foundation have
/// userId and anonOwnerId both null ("legacy unowned"): never shown to anyone, never touched by the purge.
model ChatThread {
  id        String   @id @default(cuid())
  title     String   @default("New thread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Clerk userId of the signed-in owner. Kept until the owner deletes the conversation or the account.
  userId      String?
  /// Signed-out owner: the random id in the signed bci_anon cookie (no account link). Purged after 90 days
  /// without activity unless something in the thread is saved. Cleared when the thread is claimed.
  anonOwnerId String?
  /// When a signed-out thread was claimed by its signed-in owner (same browser, within 24h, once).
  claimedAt   DateTime?

  messages ChatMessage[]
  saved    SavedItem[]

  @@index([userId])
  @@index([anonOwnerId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String
  content   String
  citations String?
  createdAt DateTime @default(now())
  /// The ChatQuestionLog row written for this turn. The link points from the owner's thread to the log row
  /// only: a private log row never carries a threadId (Decision A), so deleting the conversation can still
  /// find and delete its private log rows.
  questionLogId String?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  saved  SavedItem[]
}

/// A saved answer or deal (Batch 3 UI; the table ships with the foundation so retention can honor saves).
model SavedItem {
  id          String   @id @default(cuid())
  /// Owner: Clerk userId when signed in; anonOwnerId only for a save made before sign-in (claimed with the thread).
  userId      String?
  anonOwnerId String?
  /// "answer" | "deal"
  kind        String
  threadId    String?
  messageId   String?
  dealSlug    String?
  createdAt   DateTime @default(now())

  thread  ChatThread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonOwnerId])
  @@index([threadId])
}

/// Visitor ideas and feedback shared to improve Chat (Hal, 15 Nov 2026).
/// source is "signed-out" or "signed-in". Signed-in rows are created only when the person
/// explicitly shares an idea (the private thread is not scraped).
model ChatIdea {
  id        String   @id @default(cuid())
  text      String
  threadId  String?
  source    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

/// Per-person Chat settings (signed-in only). No row = defaults: training opt-in OFF (Decision C).
/// r4 (S6): which signed-out browser ids (bci_anon) a signed-in user has used, recorded when a signed-in request
/// carries the cookie. Only used to delete that user's unclaimed signed-out threads on account deletion; the
/// rows go with the account (user.deleted).
model ChatAnonLink {
  anonId    String
  userId    String
  createdAt DateTime @default(now())

  @@id([anonId, userId])
  @@index([userId])
}

model ChatUserPref {
  userId       String    @id
  trainOptIn   Boolean   @default(false)
  trainOptInAt DateTime?
  updatedAt    DateTime  @updatedAt
}

/// Memory-loop log: questions + answers for coverage learning and future fine-tune export.
/// Training corpus may only use our answers + public graph/digests (see data/train/README.md).
model ChatQuestionLog {
  id             String   @id @default(cuid())
  question       String
  marketSlug     String?
  intent         String?
  /// Full assistant answer text (preferred for train export).
  answerText     String?
  /// Short preview (first ~240 chars); kept for dashboards / coverage UI.
  answerSnippet  String?
  /// JSON-stringified string[] of sourceLabel / digest paths.
  citationsJson  String?
  answeredWell   Boolean  @default(false)
  /// "llm" | "memo" (deterministic memo fallback).
  modelUsed      String?
  /// Public signed-out chat → true (corpus). Clerk signed-in private workspace → false.
  trainEligible  Boolean  @default(true)
  /// Clerk signed-in = encrypted / private workspace path.
  isPrivate      Boolean  @default(false)
  /// Clerk userId when signed in; null for anonymous public chat.
  userId         String?
  threadId       String?
  /// How the question was asked: "typed" | "starter" | "reask" | "link". Null on rows before 2026-10-27.
  source         String?
  createdAt      DateTime @default(now())

  @@index([intent])
  @@index([source])
  @@index([marketSlug])
  @@index([createdAt])
  @@index([modelUsed])
  @@index([answeredWell])
  @@index([trainEligible])
  @@index([isPrivate])
  @@index([userId])
}
