# PostgreSQL — required for local and production (Prisma provider is postgresql).
# Local demo: Neon free/claimable, Docker Postgres, or any hosted Postgres.
# Example (replace USER/PASSWORD/HOST/DB):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bungah_capital_intel?schema=public"

# Neon pooled example (recommended for Vercel serverless):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Docker local example:
# docker run --name bungah-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=bungah_capital_intel -p 5432:5432 -d postgres:16
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bungah_capital_intel?schema=public"

# --- Clerk (Development: pk_test_ / sk_test_) ---
# Dashboard → API Keys. Never commit real secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# App Router paths (keep /login and /signup — not /sign-in)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workspace
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/workspace

# --- Chat LLM (graph-grounded; OFF by default — Hal spend lock) ---
# Default false: chat uses deterministic Capital Graph + digest memos only.
# Do NOT enable until revenue / paying members / spend approved. No Groq/Gateway/OpenAI
# inference runs while BUNGAH_USE_LLM is unset/false (even if keys are present).
# Public questions remain eligible for corpus logging for a future OSS fine-tune;
# private workspace bodies are excluded.
BUNGAH_USE_LLM=false
# When/if enabled later (OSS preferred order: Groq → Gateway OSS → OpenAI):
# GROQ_API_KEY=
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# Default OSS slugs (only used when BUNGAH_USE_LLM=true):
# BUNGAH_CHAT_MODEL=meta/llama-3.3-70b
# Groq path uses llama-3.3-70b-versatile unless overridden.
