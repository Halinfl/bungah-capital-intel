{
  "name": "bungah-capital-intel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/embed-corpus.mjs && prisma generate && tsx scripts/chat/verify-starters.ts && next build",
    "test:starters": "tsx scripts/chat/verify-starters.ts",
    "postbuild": "node scripts/check-ic-frame.mjs",
    "test:ic-frame": "node scripts/check-ic-frame.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/guard-seed.mjs db:push && prisma db push",
    "db:seed": "node scripts/guard-seed.mjs db:seed && tsx prisma/seed.ts",
    "db:seed:sweep-2026-10-11": "node scripts/guard-seed.mjs db:seed:sweep-2026-10-11 && tsx prisma/seed-sweep-2026-10-11.ts",
    "db:seed:world-cup-atlas-2026-10-11": "node scripts/guard-seed.mjs db:seed:world-cup-atlas-2026-10-11 && tsx prisma/seed-world-cup-atlas-2026-10-11.ts",
    "db:seed:demand-w1-2026-10-11": "node scripts/guard-seed.mjs db:seed:demand-w1-2026-10-11 && tsx prisma/seed-demand-w1-2026-10-11.ts",
    "db:seed:depth-w1-linked-2026-10-11": "node scripts/guard-seed.mjs db:seed:depth-w1-linked-2026-10-11 && tsx prisma/seed-depth-w1-linked-2026-10-11.ts",
    "db:seed:tax-series-2026-10-11": "node scripts/guard-seed.mjs db:seed:tax-series-2026-10-11 && tsx prisma/seed-tax-series-2026-10-11.ts",
    "db:reset": "node scripts/guard-seed.mjs db:reset && prisma db push --force-reset && npm run db:seed",
    "radars:run": "node scripts/guard-seed.mjs radars:run && tsx scripts/run-radars.ts",
    "train:export": "tsx scripts/export-train-corpus.ts",
    "postinstall": "prisma generate",
    "corpus:embed": "node scripts/embed-corpus.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:smoke": "node scripts/ops/smoke.mjs",
    "predeploy": "bash scripts/ops/predeploy.sh",
    "postdeploy": "bash scripts/ops/postdeploy.sh"
  },
  "prisma": {
    "seed": "node scripts/guard-seed.mjs prisma-seed && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.88",
    "@clerk/nextjs": "^7.9.4",
    "@prisma/client": "6.19.3",
    "ai": "^5.0.108",
    "next": "15.5.25",
    "prisma": "6.19.3",
    "react": "^19.1.4",
    "react-dom": "^19.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
